# Устанавливается как /etc/docragenslate/backup-storage.env (0644, без секретов).
RAG_BACKUP_ROOT=/backup
RAG_BACKUP_STATE_DIR=/var/lib/docragenslate/backup-metrics

# Необязательная host-attestation. Значения копируются из:
#   findmnt -n -o SOURCE,FSTYPE -T /backup
# При задании любое расхождение блокирует backup до вмешательства оператора.
# RAG_BACKUP_EXPECTED_SOURCE=backup-nas.internal:/docragenslate
# RAG_BACKUP_EXPECTED_FSTYPE=nfs4
