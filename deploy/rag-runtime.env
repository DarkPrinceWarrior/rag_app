# Отслеживаемая, несекретная production-конфигурация API и основного worker.
# Этот файл загружается systemd ПОСЛЕ корневого .env, поэтому принятые режимы
# не зависят от окружения интерактивной/tmux-сессии. Секреты сюда не добавлять.
RAG_RAG_CONTEXT_BUDGET_MODE=enforce
# RAG-числа сверяются с реально использованными чанками; warn сохраняет
# неблокирующую UI-пометку только для значений, отсутствующих в evidence.
RAG_RAG_QUANTITY_GUARD_MODE=warn
RAG_VISUAL_ENABLED=true
RAG_PARSER_QUALITY_SHADOW_ENABLED=true
RAG_PARSER_PAGE_ROUTER_MODE=shadow
# Entity guard в shadow только измеряет агрегаты и не меняет текст перевода.
RAG_TRANSLATION_ENTITY_GUARD_MODE=shadow
# Память переводов применяет только точное approved-совпадение внутри owner/folder/project;
# nearest-примеры пока отключены, чтобы не влиять на модель без накопленной оценки.
RAG_TRANSLATION_MEMORY_MODE=enforce
RAG_TRANSLATION_MEMORY_NEAREST_TOP_K=0
# Split включён после fake-UUID canary; legacy worker остаётся для drain старых задач.
RAG_QUEUE_ROLLOUT_MODE=split
