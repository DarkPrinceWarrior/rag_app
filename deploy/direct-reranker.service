# Deterministic Qwen3-Reranker-4B qualification runtime on GPU5, port 8013.
# MinerU is paused during the isolated qualification and restored afterwards.
[Unit]
Description=Deterministic Qwen3-Reranker-4B qualification (GPU5, :8013)
After=network-online.target
Wants=network-online.target
Conflicts=mineru-vllm.service

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=5
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:2
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=DIRECT_RERANK_MODEL_PATH=/root/models/Qwen3-Reranker-4B
Environment=DIRECT_RERANK_SERVED_MODEL_NAME=qwen3-reranker-4b
Environment=DIRECT_RERANK_MAX_LENGTH=8192
Environment=DIRECT_RERANK_BATCH_SIZE=4
Environment=PATH=/root/services/vllm-qwen32b/.venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/projects/rag_app/scripts
ExecStart=/usr/bin/numactl --cpunodebind=1 --membind=1 \
    /root/services/vllm-qwen32b/.venv/bin/uvicorn direct_qwen3_reranker_server:app \
    --host 127.0.0.1 \
    --port 8013
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
