[Unit]
Description=DocRAGenslate queue and quality metrics exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Do not run from the repository: Settings has env_file=".env" and would otherwise
# load the production owner env implicitly even without an EnvironmentFile directive.
WorkingDirectory=/
Environment=PYTHONPATH=/root/projects/rag_app/src
Environment=PYTHONUNBUFFERED=1
# Exporter reads only Redis queue/quality aggregates; it receives no DB/S3/OIDC secrets.
Environment=RAG_REDIS_HOST=127.0.0.1
Environment=RAG_REDIS_PORT=6379
Environment=RAG_REDIS_DB=0
ExecStart=/root/projects/rag_app/.venv/bin/uvicorn rag_app.metrics_exporter:app --host 127.0.0.1 --port 9108
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=rag-app.target
