[Unit]
Description=DocRAGenslate ARQ worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/rag_app
Environment=PYTHONPATH=/root/projects/rag_app/src
Environment=PYTHONUNBUFFERED=1
# Installer creates this systemd-compatible file from .env.worker.local (0600).
EnvironmentFile=/etc/docragenslate/worker.env
EnvironmentFile=/root/projects/rag_app/deploy/rag-runtime.env
ExecStart=/root/projects/rag_app/.venv/bin/arq rag_app.workers.main.WorkerSettings
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
# Длинная остановка дает ARQ завершить активный parse/translate вместо SIGKILL.
TimeoutStopSec=3600
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=rag-app.target
