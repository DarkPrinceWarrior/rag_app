{
  "name": "rag-app-extension",
  "description": "rag_app — перевод выделения и страниц (EN→RU), on-prem контур",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.12.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:prod": "pnpm icons && node scripts/build-production.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "zip": "wxt zip",
    "smoke:prod": "node e2e/smoke_prod.mjs",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wxt": "^0.20.27"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
